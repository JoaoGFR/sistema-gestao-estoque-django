# --- SEGURANÇA (O mais importante) ---
.env
.env.*
secrets.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class

# --- Django ---
*.log
db.sqlite3
db.sqlite3-journal
local_settings.py

# --- Arquivos Estáticos e Mídia (Gerados automaticamente) ---
staticfiles/
media/
assets/

# --- Testes e Cobertura de Código (Importante para o futuro) ---
.coverage
htmlcov/
.pytest_cache/
nosetests.xml
coverage.xml

# --- Traduções (Caso seu SaaS tenha múltiplos idiomas) ---
*.mo
*.pot

# --- Jupyter Notebooks (Caso faça análise de dados do estoque) ---
.ipynb_checkpoints

# --- Ambientes Virtuais ---
venv/
env/
.venv/

# --- IDEs e Sistema Operacional ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Docker ---
